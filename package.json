{
  "name": "dsh-devship",
  "version": "1.1.1",
  "description": "DevShip for DeepSeek Harness: a right-sidebar console that lists runnable services in the workspace, starts and stops them, packages with Maven or pnpm, deploys over SSH and restarts the docker container.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "deploy",
    "devops",
    "maven",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoncdj/dsh-devship.git"
  },
  "homepage": "https://github.com/dragoncdj/dsh-devship#readme",
  "bugs": {
    "url": "https://github.com/dragoncdj/dsh-devship/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
